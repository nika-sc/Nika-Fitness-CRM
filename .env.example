FLASK_ENV=development
SECRET_KEY=change-me-in-production
DB_DRIVER=postgres
APP_EDITION=selfhosted

# Single-tenant club database (required)
DATABASE_URL=postgresql://nikafit:nikafit@127.0.0.1:5432/nika_fitness

# Demo autofill. Keep false in production.
DEMO_MODE=false
DEMO_STAFF_USER=admin
DEMO_STAFF_PASSWORD=admin123
DEMO_PORTAL_LOGIN=
DEMO_PORTAL_PASSWORD=

APP_HOST=127.0.0.1
APP_PORT=5001
SESSION_COOKIE_NAME=nikafit_session
TRUSTED_HOSTS=localhost,127.0.0.1
MEMBERSHIP_EXPIRING_DAYS=7
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@nika-fitness.local

RATELIMIT_STORAGE_URI=memory://
# Several gunicorn workers: redis://127.0.0.1:6379/0 — falls back to memory if Redis is down
PAYMENTS_WEBHOOK_SECRET=
